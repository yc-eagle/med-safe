# ============================================================
# MedSafe — 环境变量模板
# ============================================================
# 用法：
#   1. 复制本文件为 .env
#   2. 在 .env 里填真实值
#   3. ⚠️ 永远不要提交 .env（.gitignore 已排除）
#
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env
# ============================================================

# ---- 模型服务（示例，按实际选型改）----
# 本地推理（推荐：离线是项目的核心卖点）
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_MODEL=

# 云端兜底（仅在允许联网的场景使用）
# ⚠️ 填入真实 key 后，请确认 .env 没有被 git 跟踪：git status 应看不到它
API_KEY=
API_BASE_URL=

# ---- 药物数据 ----
# 本地数据文件路径（不要把数据文件本身提交到大文件目录）
DRUG_DB_PATH=

# ---- 服务端口 ----
PORT=3000
